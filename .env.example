NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"
SUPABASE_STORAGE_BUCKET="clinica-saas"

# ─── Better Auth ──────────────────────────────────────────────────
BETTER_AUTH_SECRET="troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres"
BETTER_AUTH_URL="http://localhost:3000"

