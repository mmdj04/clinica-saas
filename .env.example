# ─── Banco de dados ───────────────────────────────────────────────
# PostgreSQL do Supabase (ou local via docker-compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinica_saas?schema=public"

# ─── Supabase ─────────────────────────────────────────────────────
