{
  "name": "clinica-saas",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS de gestão para clínicas pequenas e médias — agenda, pacientes, financeiro, prontuário e relatórios, com arquitetura multi-tenancy.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
